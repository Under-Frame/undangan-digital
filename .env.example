# Salin menjadi .env.local lalu isi.
# Jika tiga variabel Supabase dikosongkan, aplikasi berjalan dalam "Mode demo"
# (RSVP & ucapan disimpan sementara di memori server).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# RAHASIA: hanya dipakai di server. Jangan pernah diberi awalan NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Password dashboard admin per pasangan (dirujuk dari config: "ENV:ADMIN_PASSWORD_RINA_DIMAS").
ADMIN_PASSWORD_RINA_DIMAS=

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Opsional: tambahan kunci tanda tangan sesi admin.
ADMIN_SESSION_SECRET=
